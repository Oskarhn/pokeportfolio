# Names only. Values for the LOCAL isolated stack come from `pnpm backend:start` /
# `node scripts/local-backend.mjs env` (public URL + publishable key). Never put a service-role or
# secret key here, and never point this spike at a hosted project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Android emulator only: host alias for the Windows host loopback (default 10.0.2.2).
EXPO_PUBLIC_ANDROID_EMULATOR_HOST=
# Optional. Set to "adb-reverse" when the device reaches the host via `adb reverse tcp:55321 tcp:55321`.
EXPO_PUBLIC_ANDROID_LOOPBACK=
