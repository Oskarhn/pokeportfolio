{
  "expo": {
    "name": "PokePortfolio Spike",
    "slug": "pokeportfolio-mobile-spike",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F11",
    "scheme": "pokeportfolio-spike",
    "ios": { "bundleIdentifier": "invalid.pokeportfolio.spike", "supportsTablet": false },
    "android": { "package": "invalid.pokeportfolio.spike" },
    "plugins": [
      "./plugins/with-local-cleartext",
      "./plugins/with-navigation-bar-follows-theme",
      "./plugins/with-dark-splash-background",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a card photo to preview. Photos stay on this device.",
          "cameraPermission": "Take a card photo to preview. Photos stay on this device."
        }
      ]
    ]
  }
}
