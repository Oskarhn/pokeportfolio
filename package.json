{
  "name": "pokeportfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prepare-scanner-assets.mjs && node scripts/prepare-scanner-visual-assets.mjs && node scripts/scanner-visual-index/stage-index-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:m12-adversarial": "vitest run --config test/m12-independent-adversarial/vitest.config.ts",
    "test:m13-adversarial": "vitest run --config test/m13-independent-adversarial/vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset",
    "db:dump": "supabase db dump --linked -f supabase/dumps/pre-migration.sql",
    "db:types": "supabase gen types typescript --local --schema public > src/data/database.types.ts",
    "scanner:visual:benchmark": "tsx scripts/scanner-visual-benchmark/run-benchmark.ts",
    "scanner:visual:benchmark:hard": "tsx scripts/scanner-visual-benchmark/run-hard-benchmark.ts",
    "scanner:visual:benchmark:photometric": "tsx scripts/scanner-visual-benchmark/run-photometric-experiment.ts",
    "scanner:visual:benchmark:cold-start": "node scripts/scanner-visual-benchmark/browser-cold-start.mjs",
    "scanner:visual:benchmark:hash": "tsx scripts/scanner-visual-benchmark/run-hash-benchmark.ts",
    "scanner:index:build": "tsx scripts/scanner-visual-index/build-index.ts",
    "scanner:index:verify": "tsx scripts/scanner-visual-index/verify-index.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-virtual": "^3.14.10",
    "lightweight-charts": "5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sharp": "0.34.5",
    "supabase": "^2.114.0",
    "tesseract.js-core": "7.0.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
