# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
#
# Anything prefixed VITE_ is embedded in the browser bundle and is public.
# Anything without that prefix is build/tooling only and never reaches the client.
#
# The Supabase secret key (legacy name: service_role) does NOT belong in this file
# or any file in this repository. It lives only in the Edge Function environment,
# where the platform injects it. See docs/SECURITY.md §6.

# ── Supabase (client-visible) ──────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (legacy name: anon key). Public by design — row-level security
# is the access gate, not this key. pokeportfolio-dev issues `sb_publishable_...`
# (M6); the local stack still emits the legacy anon JWT under this same variable
# when running against `supabase start` — either works, since both authenticate
# as the same `anon` Postgres role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase CLI (tooling only, not bundled) ───────────────────────────────
# Project ref used by `supabase link`, `db push` and `config push`.
SUPABASE_PROJECT_REF=

# ── Edge Function environment (set with `supabase secrets set`, never here) ─
# Comma-separated origins the redeem-invitation function answers CORS for.
# Defaults to http://localhost:5173 when unset. CORS is not the security
# boundary — the invitation token is — but a wildcard is still sloppy.
# ALLOWED_ORIGINS=https://<the deployed app origin>

# ── Application ────────────────────────────────────────────────────────────
# Public URL of the deployment. Invitation links are built from the browser's
# own origin at runtime, so this is informational for now.
VITE_APP_URL=http://localhost:5173
