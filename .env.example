# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
#
# Anything prefixed VITE_ is embedded in the browser bundle and is public.
# Anything without that prefix is build/tooling only and never reaches the client.
#
# The Supabase service_role key does NOT belong in this file or any file in this
# repository. It lives only in Supabase Edge Function secrets. See docs/SECURITY.md §6.

# ── Supabase (client-visible) ──────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Anon/publishable key. Public by design — row-level security is the access gate,
# not this key.
VITE_SUPABASE_ANON_KEY=

# ── Supabase CLI (tooling only, not bundled) ───────────────────────────────
# Project ref used by `supabase link` and migration commands.
SUPABASE_PROJECT_REF=

# ── Application ────────────────────────────────────────────────────────────
# Public URL of the deployment. Used for building invitation links.
VITE_APP_URL=http://localhost:5173
