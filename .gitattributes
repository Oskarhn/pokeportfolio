# Normalize line endings so Windows checkouts don't produce diff noise.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary.
*.png  binary
*.jpg  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.onnx binary

# Lockfiles: keep diffs collapsed in review.
pnpm-lock.yaml linguist-generated=true -diff
